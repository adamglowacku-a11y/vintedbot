{
  "manifest_version": 3,
  "name": "VintedFlow Seller Automation",
  "short_name": "VintedFlow",
  "description": "Secure Vinted seller automation companion connected to the VintedFlow SaaS dashboard.",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "VintedFlow"
  },
  "side_panel": {
    "default_path": "src/popup/index.html"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "permissions": ["storage", "tabs", "alarms", "scripting", "sidePanel"],
  "externally_connectable": {
    "matches": [
      "https://vintly.live/*",
      "https://www.vintly.live/*",
      "https://*.vercel.app/*",
      "http://localhost/*",
      "http://127.0.0.1/*"
    ]
  },
  "host_permissions": [
    "https://*.vinted.com/*",
    "https://*.vinted.pl/*",
    "https://*.vinted.fr/*",
    "https://*.vinted.de/*",
    "https://*.vinted.it/*",
    "https://*.vinted.es/*",
    "https://*.vinted.nl/*",
    "https://*.vinted.be/*",
    "https://*.vinted.co.uk/*",
    "https://vintly.live/*",
    "https://www.vintly.live/*",
    "https://*.vercel.app/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://*.supabase.co/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.vinted.com/*",
        "https://*.vinted.pl/*",
        "https://*.vinted.fr/*",
        "https://*.vinted.de/*",
        "https://*.vinted.it/*",
        "https://*.vinted.es/*",
        "https://*.vinted.nl/*",
        "https://*.vinted.be/*",
        "https://*.vinted.co.uk/*"
      ],
      "js": ["content/vinted.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://vintly.live/*",
        "https://www.vintly.live/*",
        "https://*.vercel.app/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["content/dashboard-bridge.js"],
      "run_at": "document_idle"
    }
  ]
}
